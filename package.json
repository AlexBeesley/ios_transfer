{
  "name": "ios-transfer",
  "version": "1.0.0",
  "description": "Free Windows app to copy iPhone photos and videos over USB 3. Open-source iMazing alternative for camera-roll transfer.",
  "keywords": [
    "iphone",
    "ipad",
    "ios",
    "windows",
    "photo-transfer",
    "video-transfer",
    "usb",
    "heic",
    "live-photos",
    "imazing-alternative",
    "afc",
    "usbmux"
  ],
  "homepage": "https://github.com/AlexBeesley/ios_transfer",
  "bugs": {
    "url": "https://github.com/AlexBeesley/ios_transfer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexBeesley/ios_transfer.git"
  },
  "license": "MIT",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "doctor": "node scripts/build.mjs --tools && node scripts/run-tool.mjs dist/tools/doctor.js",
    "e2e": "node scripts/build.mjs --tools && node scripts/run-tool.mjs dist/tools/e2e.js",
    "uitest": "node scripts/build.mjs --tools && electron dist/uitest/main.js",
    "icon": "node scripts/make-icon.mjs",
    "package": "npm run build && node scripts/make-icon.mjs && node scripts/package.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "electron": "^28.3.3",
    "esbuild": "^0.20.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.3"
  },
  "productName": "iOS Transfer",
  "author": "ios-transfer",
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  }
}
